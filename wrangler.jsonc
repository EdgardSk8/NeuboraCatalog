{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "nouboracatalog",
  "compatibility_date": "2026-11-12",
  "pages_build_output_dir": "./dist",
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "nouboracatalog",
      "database_id": "c850de7e-b330-41df-90c1-f2336bb0e40f",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "FILES",
      "bucket_name": "nouboracatalog-files-production"
    }
  ],
  "services": [
    {
      "binding": "MAILER",
      "service": "nouboracatalog-mailer"
    }
  ],
  "env": {
    "preview": {
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "nouboracatalog-preview",
          "database_id": "ff212bee-ce8e-4490-a396-623b4c3a97a6",
          "migrations_dir": "migrations"
        }
      ],
      "r2_buckets": [
        {
          "binding": "FILES",
          "bucket_name": "nouboracatalog-files-preview"
        }
      ]
    }
  }
}
